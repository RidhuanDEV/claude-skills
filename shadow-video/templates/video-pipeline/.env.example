# Salin menjadi .env (PowerShell: Copy-Item .env.example .env, Bash: cp .env.example .env). .env diabaikan git.

# Frontend LOKAL atau STAGING yang memakai database uji. Jangan pernah mengarah ke produksi.
BASE_URL=http://127.0.0.1:5173

# Pipeline menolak berjalan bila host BASE_URL ada di daftar ini. Isi host produksi sebagai pengaman (wajib).
BLOCKED_HOSTS=app.contoh.go.id

# Akun demo utama untuk `npm run login -- --auto` dan placeholder {{LOGIN_EMAIL}} / {{LOGIN_PASSWORD}}.
# Kata sandi tidak pernah dicetak.
LOGIN_EMAIL=
LOGIN_PASSWORD=

# Akun peran lain: satu pasangan <PREFIX>_EMAIL/<PREFIX>_PASSWORD untuk setiap prefix di
# video.config.json "rolePrefixes". Dipakai sebagai {{ADMIN_EMAIL}} dan `npm run snapshot -- ADMIN /rute`.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# TTS: azure (Azure AI Speech resmi, boleh komersial; tier gratis F0 cukup) | edge (tidak resmi, hanya pratinjau internal)
TTS_PROVIDER=azure
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
TTS_VOICE=id-ID-GadisNeural
# TTS_VOICE=id-ID-ArdiNeural
TTS_RATE=+0%
TTS_PITCH=+0Hz

# Binary (opsional). Bawaan: ffmpeg/ffprobe dari PATH; python dari .venv bila ada, selain itu "python".
# FFMPEG_PATH=C:\tools\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\tools\ffmpeg\bin\ffprobe.exe
# PYTHON_PATH=C:\Python313\python.exe

# Perekam dan E2E
# HEADED=1                 # tampilkan browser (record dan e2e)
# E2E_SLOWMO_MS=150        # jeda antar-operasi e2e saat headed agar mudah diikuti mata
# SLOW_FACTOR=1            # >1 memperlambat semua gerakan kursor rekaman (debug)
# AV_OFFSET_MS=0           # geser narasi lebih lambat (+) atau lebih cepat (-) bila tidak sinkron

# Keluaran
OUTPUT_FPS=25
X264_CRF=18
X264_PRESET=slow

# Login yang direkam (recordLogin) dan `npm run login -- --auto`: 1 = headed (bawaan, wajib bila ada captcha
# seperti Cloudflare Turnstile), 0 = headless untuk aplikasi tanpa captcha. Isi video tetap sama.
RECORD_LOGIN_HEADED=1

# Browser: "chrome" (Google Chrome terpasang, bawaan, lolos Turnstile) atau "chromium" (bawaan Playwright).
# BROWSER_CHANNEL=chromium
# BROWSER_LANG=id-ID

# Override logo dari video.config.json (opsional; relatif terhadap video-pipeline/ atau absolut)
# BRAND_LOGO_ICON=../public/logo.png
# BRAND_LOGO_FULL=../public/logo-full.png

# Mail catcher staging untuk aksi fetchMail (opsional, misalnya Mailpit)
# MAILPIT_URL=http://127.0.0.1:8025
