# Normalize line endings across Windows, macOS, and Linux
* text=auto eol=lf

# Windows scripts require CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.gif binary
*.ico binary
*.pdf binary
*.mp4 binary
*.wav binary
*.mp3 binary
*.zip binary
*.docx binary
*.xlsx binary
*.sqlite binary
*.db binary
